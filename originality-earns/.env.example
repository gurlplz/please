# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# --- TwitterAPI.io ---
TWITTERAPI_IO_KEY=your_twitterapi_io_key

# --- Originality.ai ---
ORIGINALITY_AI_KEY=your_originality_ai_key
# Optional override if your account uses a non-default gateway
# ORIGINALITY_AI_API_URL=https://api.originality.ai/api/v1

# --- Base / wagmi ---
NEXT_PUBLIC_BASE_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_ORIGIN_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_REWARD_DISTRIBUTOR_ADDRESS=0x0000000000000000000000000000000000000000

# Optional WalletConnect (only if you enable the WalletConnect connector)
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- App secrets ---
# Shared secret for cron routes + the websocket worker (`Authorization: Bearer ...`)
CRON_SECRET=change_me_to_a_long_random_string

# --- Scoring knobs ---
NOVELTY_SIMILARITY_THRESHOLD=0.85
HUMAN_SCORE_FLOOR=0.55

# --- Weekly airdrop helper route ---
WEEKLY_TOP_N=25
WEEKLY_REWARD_PER_WINNER=25

# --- Foundry deployment (never commit real keys) ---
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=optional_for_verification
